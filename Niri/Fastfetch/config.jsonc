{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "color": "38;2;79;190;240", // Ciano Miku (#4FBEF0)
        "separator": " ➜  "
    },
    "modules": [
	"break",
	"break",
	"break",
	"break",
        {
            "type": "title",
            "key": " ",
            "keyColor": "38;2;79;190;240"
        },
        {
            "type": "custom",
            "format": "┌────────────────────────────────────────┐"
        },
        { "type": "os", "key": "󰣇", "format": "{2}" }, 
        { "type": "kernel", "key": "󰌽 ", "format": "{2}" },
        { "type": "wm", "key": "󱂬 ", "format": "{1}" },
        { "type": "uptime", "key": "󰔚 " },
        { "type": "terminal", "key": "󰆍 " },
        { "type": "packages", "key": "󰏖 " },
        {
            "type": "custom",
            "format": "└────────────────────────────────────────┘"
        },
        // Módulo de cores personalizado com a sua paleta
        {
            "type": "custom",
            "format": "\u001b[38;2;30;62;74m󰄯 \u001b[38;2;27;85;158m󰄯 \u001b[38;2;53;138;199m󰄯 \u001b[38;2;79;190;240m󰄯"
        },
        "break"
    ],
    "logo": {
        "type": "kitty",
        "source": "/home/herbert/.config/fastfetch/miku-fast.png",
        "width": 24,
        "height": 12,
        "padding": {
            "top": 2,
            "left": 2
        }
    }
}
