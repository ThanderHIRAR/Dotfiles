{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "color": "38;2;255;200;206", // Rosa pastel Teto (#FFC8CE)
        "separator": " ➜  "
    },
    "modules": [
	"break",
	"break",
	"break",
	"break",
        {
            "type": "title",
            "key": " ",
            "keyColor": "38;2;255;200;206"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;200;206m┌─────────────────────────────────┐\u001b[0m"
        },
        { "type": "os", "key": "󰣇", "format": "{2}" }, 
        { "type": "kernel", "key": "󰌽 ", "format": "{2}" },
        { "type": "wm", "key": "󱂬 ", "format": "{1}" },
        { "type": "uptime", "key": "󰔚 " },
        { "type": "terminal", "key": "󰆍 " },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;200;206m└─────────────────────────────────┘\u001b[0m"
        },
        // Módulo de cores personalizado com a nova paleta
        {
            "type": "custom",
            "format": "\u001b[38;2;60;22;32m󰄯 \u001b[38;2;102;37;54m󰄯 \u001b[38;2;176;48;77m󰄯 \u001b[38;2;255;200;206m󰄯\u001b[0m"
        },
        "break"
    ],
    "logo": {
        "type": "kitty",
        "source": "/home/herbert/.config/fastfetch/teto-fast.png",
        "width": 24,
        "height": 12,
        "padding": {
            "top": 2,
            "left": 2
        }
    }
}