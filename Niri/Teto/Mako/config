# Configuração Mako com alto contraste
max-history=100
sort=-time

on-notify=exec paplay --volume=42598 /home/herbert/notify.mp3

# Aparência geral
font=monospace 10
width=350
height=150
margin=10
padding=15
border-size=4
border-color=#B0304D
background-color=#4B1B28
text-color=#FFC8CE
border-radius=8

# Urgência normal
[urgency=normal]
border-color=#B0304D
default-timeout=5000

# Urgência crítica (se usar)
[urgency=critical]
border-color=#FF0000
default-timeout=0